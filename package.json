{
  "name": "swasthai",
  "private": true,
  "version": "2.0.0",
  "description": "AI-powered non-invasive routine health screening platform combining camera PPG, heart sound auscultation, cough acoustics, and gait kinematics.",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx server/auth_test.ts && tsx server/e2e_verification_test.ts && tsx server/heart_sound_test.ts && tsx server/ppg_test.ts",
    "test:auth": "tsx server/auth_test.ts",
    "test:e2e": "tsx server/e2e_verification_test.ts",
    "test:heart": "tsx server/heart_sound_test.ts",
    "test:ppg": "tsx server/ppg_test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
