# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SwasthAI Core Configuration
NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://swasth_user:swasth_pass@localhost:5432/swasthai"
JWT_SECRET="swasthai_jwt_super_secret_key_2026_dev"
JWT_REFRESH_SECRET="swasthai_jwt_refresh_super_secret_key_2026_dev"

# Development & Seed RBAC Accounts
ADMIN_EMAIL="admin@swasthai.com"
ADMIN_PASSWORD="Admin@Swasth2026!"
OPERATOR_EMAIL="operator@swasthai.com"
OPERATOR_PASSWORD="Operator@Swasth2026!"

# Storage Configuration (S3 / Local filesystem abstraction)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_BUCKET="swasthai-health-records"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"

# Diagnostic Lab Provider Integration (mock or partner_api)
LAB_PROVIDER="mock"
LAB_API_URL="https://api.partnerlabs.in/v1"
LAB_API_KEY="mock_lab_partner_api_key_2026"

# Machine Learning Mode (demo or real)
ML_MODE="real"
HEART_SOUND_MODEL_PATH="heart_model/heart_sound_model.pt"
HEART_SOUND_MODEL_TYPE="cnn"
HEART_SOUND_NORMAL_THRESHOLD="0.40"
HEART_SOUND_FOLLOW_UP_THRESHOLD="0.65"

